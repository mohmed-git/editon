---
import Icon from './Icon.astro';
import PosterCard from './PosterCard.astro';
import { titles } from '../lib/data-static';

interface RowItem { id: string; progress?: number; episode?: string }
interface Props {
  id: string;
  title: string;
  items: (string | RowItem)[];
  landscape?: boolean;
  seeAllHref?: string;
}
const { id, title, items, landscape = false, seeAllHref } = Astro.props;

// تطبيع العناصر إلى بطاقات، مع تجاهل ما لا يوجد في قاعدة البيانات
const cards = items
  .map((it) => (typeof it === 'string' ? { id: it } : it))
  .map((it) => ({ meta: it, card: titles[it.id] }))
  .filter((x) => x.card);

const href = seeAllHref || `/category/${id}`;
const hasSeeAll = ['movie', 'series', 'anime', 'trending'].includes(id);
---
<section class="row-section" data-row={id}>
  <div class="row-header">
    <h2 class="row-title">{title}</h2>
    {hasSeeAll && (
      <a href={href} class="row-see-all">عرض الكل <Icon name="chevronL" /></a>
    )}
  </div>
  <div class={`row-scroll ${landscape ? 'landscape' : ''}`}>
    {cards.map(({ meta, card }) => (
      <PosterCard card={card} progress={meta.progress} episode={meta.episode} landscape={landscape} />
    ))}
  </div>
</section>
