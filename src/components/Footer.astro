---
import Icon from './Icon.astro';
import AdBanner from './AdBanner.astro';
---
<footer class="site-footer">
  <div class="container">
    <AdBanner variant="wide" label="عروض حصرية ومكافآت يومية" />

    <div class="footer-grid">
      <div class="footer-col footer-brand">
        <div class="logo">
          <span class="logo-mark"><Icon name="play" /></span>
          <span>سينما<b>لايف</b></span>
        </div>
        <p>سينما لايف — منصتك المتكاملة لمشاهدة أحدث الأفلام والمسلسلات والأنمي مترجمة أون لاين بجودة HD.</p>
      </div>
      <div class="footer-col">
        <h4>استكشف</h4>
        <a href="/category/movie">أفلام</a>
        <a href="/category/series">مسلسلات</a>
        <a href="/category/anime">أنمي</a>
        <a href="/category/trending">الأكثر رواجاً</a>
      </div>
      <div class="footer-col">
        <h4>مساعدة</h4>
        <a href="#">مركز الدعم</a>
        <a href="#">الأسئلة الشائعة</a>
        <a href="#">تواصل معنا</a>
        <a href="#">اقتراح عمل</a>
      </div>
      <div class="footer-col">
        <h4>الشركة</h4>
        <a href="#">عن سينما لايف</a>
        <a href="#">شروط الاستخدام</a>
        <a href="#">سياسة الخصوصية</a>
        <a href="#">الوظائف</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div>© 2026 سينما لايف. جميع الحقوق محفوظة. بيانات الأعمال والتقييمات مصدرها TMDB.</div>
      <div class="footer-socials">
        <a href="#" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href="#" aria-label="Twitter"><Icon name="twitter" /></a>
        <a href="#" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href="#" aria-label="YouTube"><Icon name="youtube" /></a>
      </div>
    </div>
  </div>
</footer>
