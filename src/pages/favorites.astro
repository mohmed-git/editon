---
// ============================================================================
// صفحة المفضلة — تُبنى بالكامل في المتصفح من localStorage (بلا حساب/قاعدة بيانات)
// الصفحة نفسها ثابتة (قشرة HTML)، والقائمة تُملأ بـ JavaScript من CimaFav.
// ============================================================================
export const prerender = true;

import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { SITE_NAME } from '../lib/seo';
---
<Base
  title={`المفضلة — ${SITE_NAME}`}
  description="قائمة أعمالك المفضّلة على سينما لايف — أفلام ومسلسلات وأنمي حفظتها للمشاهدة لاحقاً."
  canonical="/favorites"
  robots="noindex, follow"
>
  <Nav />
  <main data-screen-label="المفضلة">
    <section class="fav-page">
      <div class="fav-page-inner">
        <header class="fav-head">
          <h1><Icon name="heart" /> المفضلة</h1>
          <p id="favSubtitle" class="fav-subtitle">أعمالك المحفوظة للمشاهدة لاحقاً.</p>
          <button id="favClearBtn" class="btn btn-ghost" type="button" hidden>
            <Icon name="close" /> <span>مسح الكل</span>
          </button>
        </header>

        <!-- حالة فارغة -->
        <div id="favEmpty" class="fav-empty" hidden>
          <div class="fav-empty-icon"><Icon name="heart" /></div>
          <h2>لا توجد أعمال في المفضلة بعد</h2>
          <p>اضغط على أيقونة القلب على أي فيلم أو مسلسل أو أنمي لإضافته هنا.</p>
          <a href="/" class="btn btn-primary"><Icon name="play" /> <span>تصفّح الأعمال</span></a>
        </div>

        <!-- الشبكة -->
        <div id="favGrid" class="fav-grid"></div>
      </div>
    </section>
    <Footer />
  </main>
</Base>

<script is:inline>
  (function () {
    function typeLabel(t) {
      return t === 'movie' ? 'فيلم' : t === 'anime' ? 'أنمي' : t === 'series' ? 'مسلسل' : '';
    }
    function esc(s) {
      return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }
    function cardHtml(w) {
      var badge = typeLabel(w.type) ? '<span class="poster-badge">' + typeLabel(w.type) + '</span>' : '';
      var rating = w.rating ? '<span class="rating"><svg viewBox="0 0 24 24" fill="currentColor" width="12" height="12"><path d="M12 17.27l6.18 3.73-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg> ' + w.rating + '</span>' : '';
      var year = w.year ? '<span>' + esc(w.year) + '</span>' : '';
      var poster = esc(w.poster || '');
      var title = esc(w.title || '');
      var id = esc(w.id);
      return (
        '<div class="poster-card fav-card" data-id="' + id + '">' +
          '<button class="card-fav is-fav" type="button" data-fav-remove="' + id + '" aria-label="إزالة من المفضلة" title="إزالة من المفضلة">' +
            '<svg viewBox="0 0 24 24" fill="currentColor" width="17" height="17"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>' +
          '</button>' +
          '<a class="poster-card-inner" href="/title/' + id + '">' +
            '<img src="' + poster + '" alt="' + title + '" loading="lazy" />' +
            badge +
            '<div class="poster-hover">' +
              '<div class="poster-hover-title">' + title + '</div>' +
              '<div class="poster-hover-meta">' + rating + year + '</div>' +
              '<div class="poster-hover-actions">' +
                '<button class="poster-play-btn" type="button" aria-label="تشغيل" onclick="event.preventDefault();event.stopPropagation();location.href=\'/watch/' + id + '\'">' +
                  '<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>' +
                '</button>' +
              '</div>' +
            '</div>' +
          '</a>' +
        '</div>'
      );
    }

    function render() {
      var grid = document.getElementById('favGrid');
      var empty = document.getElementById('favEmpty');
      var subtitle = document.getElementById('favSubtitle');
      var clearBtn = document.getElementById('favClearBtn');
      if (!grid || !window.CimaFav) return;
      var list = window.CimaFav.all();

      if (!list.length) {
        grid.innerHTML = '';
        empty.hidden = false;
        clearBtn.hidden = true;
        subtitle.textContent = 'أعمالك المحفوظة للمشاهدة لاحقاً.';
        return;
      }
      empty.hidden = true;
      clearBtn.hidden = false;
      subtitle.textContent = list.length + ' ' + (list.length === 1 ? 'عمل محفوظ' : 'أعمال محفوظة');
      grid.innerHTML = list.map(cardHtml).join('');
    }

    document.addEventListener('DOMContentLoaded', function () {
      render();
      // إزالة عنصر عند الضغط على قلبه
      document.getElementById('favGrid').addEventListener('click', function (e) {
        var btn = e.target.closest('[data-fav-remove]');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        window.CimaFav.remove(btn.getAttribute('data-fav-remove'));
      });
      // مسح الكل
      document.getElementById('favClearBtn').addEventListener('click', function () {
        if (confirm('هل تريد مسح كل المفضلة؟')) window.CimaFav.clear();
      });
    });
    // إعادة الرسم عند أي تغيير في المفضلة
    window.addEventListener('cima:fav-changed', render);
  })();
</script>

<style>
  .fav-page { padding: calc(var(--nav-h, 64px) + var(--sp-6)) var(--sp-6) var(--sp-8); min-height: 70vh; }
  .fav-page-inner { max-width: 1600px; margin: 0 auto; }
  .fav-head { display: flex; align-items: center; gap: var(--sp-4); flex-wrap: wrap; margin-bottom: var(--sp-6); }
  .fav-head h1 { font-size: 30px; font-weight: 900; display: flex; align-items: center; gap: 10px; }
  .fav-head h1 :global(svg) { width: 28px; height: 28px; color: var(--gold); }
  .fav-subtitle { color: var(--text-secondary); font-size: 14px; margin-inline-end: auto; }
  .fav-grid {
    display: grid; gap: var(--sp-4);
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  }
  .fav-empty { text-align: center; padding: var(--sp-8) var(--sp-4); color: var(--text-secondary); }
  .fav-empty-icon { width: 72px; height: 72px; margin: 0 auto var(--sp-4); border-radius: 50%; background: var(--gold-dim); display: flex; align-items: center; justify-content: center; }
  .fav-empty-icon :global(svg) { width: 34px; height: 34px; color: var(--gold); }
  .fav-empty h2 { font-size: 20px; font-weight: 800; color: var(--text-primary); margin-bottom: 8px; }
  .fav-empty p { margin-bottom: var(--sp-5); }
  @media (max-width: 640px) {
    .fav-grid { grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); }
    .fav-head h1 { font-size: 24px; }
  }
</style>
