---
// ============================================================================
// صفحة المشاهدة / الحلقة — SSR (prerender = false) — تُخدَّم من الـ Worker
// ----------------------------------------------------------------------------
// تعتمد على route params ديناميكية (العمل/الموسم/الحلقة). لا نبنيها ملفات ثابتة
// لتفادي تضخّم عدد الملفات (خصوصاً مع نمو الحلقات) وتجاوز حد الـ 20,000.
//
// احترام حد CPU 10ms على الخطة المجانية:
//  - لا استدعاء API خارجي هنا.
//  - نقرأ فقط ملف حلقات العمل الواحد (dynamic import) — لا تحميل ضخم.
//  - كود خفيف، لا حلقات كبيرة. + تفعيل Cloudflare Cache API للطلبات المتكررة.
// ============================================================================
export const prerender = false;

import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import { getDetailSSR, getEpisodes } from '../../../../lib/data';
import type { Episode, Server } from '../../../../lib/data';
import { episodePageTag, episodeDescription, episodeSchema, displayName } from '../../../../lib/seo';

const { id, season, episode } = Astro.params;
const origin = Astro.url;
const T = await getDetailSSR(id!, origin);

if (!T) {
  return new Response('العمل غير موجود', { status: 404 });
}

const isSeries = T.type !== 'movie';
let seasonNum = Number(season) || 1;
let episodeNum = Number(episode) || 1;

let seasonEpisodes: Episode[] = [];
let currentEp: Episode | null = null;
const availableSeasons = T.seasons || [];

if (isSeries) {
  const eps = await getEpisodes(id!, origin);
  if (eps) {
    // إن لم يوجد الموسم المطلوب، نرجع لأول موسم متاح
    if (!eps[String(seasonNum)]) {
      const keys = Object.keys(eps).map(Number).sort((a, b) => a - b);
      if (keys.length) seasonNum = keys[0];
    }
    seasonEpisodes = eps[String(seasonNum)] || [];
    currentEp = seasonEpisodes.find((e) => e.num === episodeNum) || seasonEpisodes[0] || null;
    if (currentEp) episodeNum = currentEp.num;
  }
}

// سيرفرات المشاهدة الحقيقية (روابط iframe من الكتالوج) — للحلقة أو الفيلم
const epServers: Server[] = isSeries
  ? (currentEp?.servers || [])
  : (T.seasons?.length
      ? [] // للأفلام: نجلب أول حلقة من الموسم 0 عبر getEpisodes أدناه
      : []);

// للأفلام: الفيلم مخزّن كـ "حلقة" داخل episodes (موسم 0/حلقة 0 غالباً)
let movieServers: Server[] = [];
if (!isSeries) {
  const eps = await getEpisodes(id!, origin);
  if (eps) {
    const firstKey = Object.keys(eps)[0];
    const list = firstKey ? eps[firstKey] : [];
    if (list && list.length) {
      currentEp = list[0];
      movieServers = list[0].servers || [];
    }
  }
}

const activeServers: Server[] = isSeries ? epServers : movieServers;
const activeUrl = activeServers.length ? activeServers[0].url : null;

// بيانات العرض الموحّدة (فيلم أو حلقة)
const view = isSeries && currentEp
  ? {
      name: currentEp.name || `الحلقة ${episodeNum}`,
      synopsis: (currentEp.synopsis || T.synopsis || '').trim(),
      still: currentEp.still || T.backdrop || T.poster,
      rating: currentEp.rating,
      ratingSource: currentEp.ratingSource,
      voteCount: currentEp.voteCount,
      label: `الموسم ${seasonNum} · الحلقة ${episodeNum}`,
      epTag: `S${seasonNum}:E${episodeNum}`,
    }
  : {
      name: displayName(T),
      synopsis: (T.synopsis || '').trim(),
      still: T.backdrop || T.poster,
      rating: T.rating,
      ratingSource: T.ratingSource,
      voteCount: T.voteCount,
      label: 'فيلم كامل',
      epTag: 'فيلم',
    };

// الحلقة التالية (للزر)
let nextHref: string | null = null;
if (isSeries && currentEp) {
  const idx = seasonEpisodes.findIndex((e) => e.num === episodeNum);
  if (idx >= 0 && idx < seasonEpisodes.length - 1) {
    nextHref = `/watch/${id}/${seasonNum}/${seasonEpisodes[idx + 1].num}`;
  }
}

// نافذة عرض الحلقات في الشريط الجانبي: بعض الأعمال (كالأنمي الطويلة) قد تصل
// لآلاف الحلقات في موسم واحد؛ عرضها كلها في الـ SSR يُبطئ التوليد ويضخّم HTML.
// لذا نعرض نافذة حول الحلقة الحالية فقط (حتى ~SIDEBAR_WINDOW حلقة).
const SIDEBAR_WINDOW = 120;
let sidebarEpisodes = seasonEpisodes;
let sidebarStart = 0;
let sidebarHasMoreBefore = false;
let sidebarHasMoreAfter = false;
if (isSeries && seasonEpisodes.length > SIDEBAR_WINDOW) {
  const curIdx = Math.max(0, seasonEpisodes.findIndex((e) => e.num === episodeNum));
  let start = Math.max(0, curIdx - Math.floor(SIDEBAR_WINDOW / 2));
  let end = Math.min(seasonEpisodes.length, start + SIDEBAR_WINDOW);
  start = Math.max(0, end - SIDEBAR_WINDOW);
  sidebarStart = start;
  sidebarEpisodes = seasonEpisodes.slice(start, end);
  sidebarHasMoreBefore = start > 0;
  sidebarHasMoreAfter = end < seasonEpisodes.length;
}

// عناصر SEO
const pageTitle = episodePageTag(T, seasonNum, episodeNum);
const pageDesc = episodeDescription(T, seasonNum, episodeNum, currentEp);
const pageSchema = episodeSchema(T, seasonNum, episodeNum, currentEp);
const canonical = isSeries ? `/watch/${id}/${seasonNum}/${episodeNum}` : `/watch/${id}/0/0`;

// تفعيل Cache API لتقليل مرات تنفيذ كود الـ Worker على الطلبات المتكررة
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=600');
---
<Base
  title={pageTitle}
  description={pageDesc}
  canonical={canonical}
  ogImage={view.still}
  ogType={isSeries ? 'video.episode' : 'video.movie'}
  schema={pageSchema}
  bodyStyle="background:#050810;"
>
  <div class="watch-layout" data-screen-label="صفحة المشاهدة">
    <div class="player-column">
      <!-- Player -->
      <div class="player-wrap" id="playerWrap">
        <div class="player-video" id="playerVideo">
          {activeUrl ? (
            <>
              <img src={view.still} alt={view.name} class="player-poster" id="playerPoster" />
              <iframe
                id="playerFrame"
                data-src={activeUrl}
                src="about:blank"
                allow="autoplay; encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
                referrerpolicy="no-referrer"
                title={`مشاهدة ${view.name}`}
                loading="lazy"
              ></iframe>
            </>
          ) : (
            <div class="no-server">
              <Icon name="info" />
              <p>لا يوجد سيرفر مشاهدة متاح لهذه الحلقة حالياً.</p>
            </div>
          )}
        </div>
        <div class="player-top">
          <a href={`/title/${id}`} class="player-back"><Icon name="arrowR" /> <span>رجوع</span></a>
          <div class="player-title-bar">
            <h1>{T.title}</h1>
            <div class="ep">{view.label}{isSeries && currentEp ? ` — ${view.name}` : ''}</div>
          </div>
          <div class="player-top-actions">
            <button class="top-icon-btn" type="button" title="ملاحظات"><Icon name="bookmark" /></button>
            <button class="top-icon-btn" type="button" title="الإعدادات"><Icon name="settings" /></button>
          </div>
        </div>
        {activeUrl && (
          <button class="player-center-play" type="button" id="centerPlay" aria-label="تشغيل"><Icon name="play" /></button>
        )}
      </div>

      <!-- Below player -->
      <div class="below-player">
        <h1>{displayName(T)}</h1>
        <div class="subtitle">
          {T.originalTitle && T.originalTitle !== T.title ? T.originalTitle : T.titleEn}
          {T.year ? ` · ${T.year}` : ''}
          {T.country ? ` · ${T.country}` : ''}
        </div>
        <div class="ep-title">
          <span class="ep-num">{view.epTag}</span>
          <span>{view.name}</span>
          {view.rating != null && (
            <span class="rating-badge" title={`التقييم من ${view.ratingSource || 'TMDB'}`}>
              <Icon name="star" />
              <span>{Number(view.rating).toFixed(1)}</span>
              <span class="rating-src">{view.ratingSource || 'TMDB'}</span>
            </span>
          )}
        </div>
        {view.synopsis && <p class="ep-synopsis">{view.synopsis}</p>}
        <div class="quick-actions">
          {nextHref && <a class="quick-btn primary" href={nextHref}><Icon name="skipNext" /> <span>الحلقة التالية</span></a>}
          <a class="quick-btn" href={`/title/${id}`}><Icon name="list" /> <span>كل الحلقات</span></a>
          <button class="quick-btn" type="button"><Icon name="plus" /> <span>قائمتي</span></button>
          <button class="quick-btn" type="button"><Icon name="heart" /> <span>إعجاب</span></button>
        </div>

        {activeServers.length > 0 && (
          <div class="servers-section">
            <div class="servers-title">سيرفرات المشاهدة ({activeServers.length})</div>
            <div class="servers-list" id="serversList">
              {activeServers.map((s, i) => (
                <button
                  class={`server-btn ${i === 0 ? 'active' : ''}`}
                  type="button"
                  data-url={s.url}
                >
                  <span class="status-dot"></span><span>{s.name || `سيرفر ${i + 1}`}</span>
                </button>
              ))}
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Sidebar الحلقات (للأعمال المسلسلة فقط) -->
    {isSeries && seasonEpisodes.length > 0 && (
      <aside class="episodes-sidebar">
        <div class="sidebar-header">
          <div class="sidebar-title">
            <h3>الحلقات</h3>
            <p>الموسم {seasonNum} · {seasonEpisodes.length} حلقة</p>
          </div>
          <select class="sidebar-season-select" id="watchSeasonSelect">
            {availableSeasons.map((s) => (
              <option value={s.num} selected={s.num === seasonNum}>الموسم {s.num}</option>
            ))}
          </select>
        </div>
        <div class="sidebar-episodes">
          {sidebarHasMoreBefore && (
            <a class="sidebar-more" href={`/watch/${id}/${seasonNum}/${seasonEpisodes[0].num}`}>
              ↑ عرض الحلقات الأولى (من {seasonEpisodes[0].num})
            </a>
          )}
          {sidebarEpisodes.map((ep) => (
            <a class={`sidebar-episode ${ep.num === episodeNum ? 'current' : ''}`} href={`/watch/${id}/${seasonNum}/${ep.num}`}>
              <div class="sidebar-ep-thumb">
                <img src={ep.still || T.backdrop || T.poster} alt={`حلقة ${ep.num}`} loading="lazy" />
                <span class="ep-num-badge">{ep.num}</span>
                {ep.num === episodeNum && <div class="now-playing"><Icon name="playCircle" /></div>}
              </div>
              <div class="sidebar-ep-info">
                <h4>{ep.name || `الحلقة ${ep.num}`}</h4>
                <div class="meta">
                  {ep.rating != null && (
                    <span class="ep-rate" title={`تقييم الحلقة من ${ep.ratingSource || 'TMDB'}`}>
                      <Icon name="star" /> {Number(ep.rating).toFixed(1)}
                      <span class="ep-rate-src">{ep.ratingSource || 'TMDB'}</span>
                    </span>
                  )}
                  {ep.num === episodeNum ? <span class="now-tag"> · قيد المشاهدة</span> : ''}
                </div>
                {ep.num === episodeNum && <div class="sidebar-progress-bar"><div style="width:0%"></div></div>}
              </div>
            </a>
          ))}
          {sidebarHasMoreAfter && (
            <a class="sidebar-more" href={`/watch/${id}/${seasonNum}/${seasonEpisodes[seasonEpisodes.length - 1].num}`}>
              ↓ الانتقال لآخر الحلقات (حتى {seasonEpisodes[seasonEpisodes.length - 1].num})
            </a>
          )}
        </div>
      </aside>
    )}
  </div>
</Base>

<script is:inline define:vars={{ id }}>
  var frame = document.getElementById('playerFrame');
  var poster = document.getElementById('playerPoster');
  var cp = document.getElementById('centerPlay');

  function loadPlayer(url) {
    if (!frame) return;
    frame.setAttribute('src', url);
    frame.classList.add('active');
    if (poster) poster.style.display = 'none';
    if (cp) cp.style.display = 'none';
  }

  // زر التشغيل المركزي — يحمّل سيرفر المشاهدة الافتراضي (أول سيرفر)
  if (cp && frame) {
    cp.addEventListener('click', function () {
      var url = frame.getAttribute('data-src');
      if (url) loadPlayer(url);
    });
  }

  // تبديل السيرفرات
  var list = document.getElementById('serversList');
  if (list) {
    list.addEventListener('click', function (e) {
      var btn = e.target.closest('.server-btn');
      if (!btn) return;
      var url = btn.getAttribute('data-url');
      if (!url) return;
      list.querySelectorAll('.server-btn').forEach(function (b) { b.classList.remove('active'); });
      btn.classList.add('active');
      loadPlayer(url);
    });
  }

  // اختيار الموسم من الشريط الجانبي
  var sel = document.getElementById('watchSeasonSelect');
  if (sel) sel.addEventListener('change', function () { location.href = '/watch/' + id + '/' + this.value + '/1'; });
</script>

<style>
  .watch-layout { display: grid; grid-template-columns: 1fr 380px; min-height: 100vh; gap: 0; }
  .player-column { position: relative; }
  .player-wrap { position: sticky; top: 0; background: black; aspect-ratio: 16/9; overflow: hidden; }
  .player-video { position: absolute; inset: 0; background: #0a1220; overflow: hidden; }
  .player-poster { width: 100%; height: 100%; object-fit: cover; opacity: 0.9; }
  #playerFrame { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; background: #000; opacity: 0; pointer-events: none; z-index: 3; }
  #playerFrame.active { opacity: 1; pointer-events: auto; }
  .no-server { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; color: var(--text-secondary); text-align: center; padding: 20px; }
  .no-server :global(svg) { width: 42px; height: 42px; opacity: 0.6; }
  .no-server p { font-size: 15px; max-width: 320px; }
  .rating-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; background: var(--gold-dim); border: 1px solid var(--gold); border-radius: 6px; color: var(--gold); font-size: 12px; font-weight: 700; }
  .rating-badge :global(svg) { width: 13px; height: 13px; }
  .rating-badge .rating-src { font-size: 9px; font-weight: 600; opacity: 0.75; padding-inline-start: 4px; border-inline-start: 1px solid rgba(232,181,71,0.35); }
  .ep-rate { display: inline-flex; align-items: center; gap: 3px; color: var(--gold); font-weight: 600; }
  .ep-rate :global(svg) { width: 11px; height: 11px; }
  .ep-rate .ep-rate-src { font-size: 8px; opacity: 0.7; padding-inline-start: 3px; }
  .now-tag { color: var(--gold); }
  .player-top { position: absolute; top: 0; left: 0; right: 0; padding: 20px 24px; background: linear-gradient(180deg, rgba(0,0,0,0.7) 0%, transparent 100%); display: flex; align-items: center; justify-content: space-between; z-index: 5; }
  .player-back { display: inline-flex; align-items: center; gap: 8px; color: white; font-family: var(--font-heading); font-weight: 700; font-size: 15px; padding: 8px 14px; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.15); border-radius: 100px; transition: all var(--t-fast); text-decoration: none; }
  .player-back:hover { background: rgba(0,0,0,0.6); }
  .player-back :global(svg) { width: 18px; height: 18px; }
  .player-title-bar { text-align: center; color: white; flex: 1; }
  .player-title-bar h1 { font-size: 16px; font-weight: 700; margin-bottom: 2px; text-shadow: 0 2px 8px rgba(0,0,0,0.5); }
  .player-title-bar .ep { font-size: 13px; color: rgba(255,255,255,0.7); font-weight: 400; }
  .player-top-actions { display: flex; gap: 8px; }
  .top-icon-btn { width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(0,0,0,0.4); backdrop-filter: blur(10px); color: white; border: 1px solid rgba(255,255,255,0.15); transition: all var(--t-fast); cursor: pointer; }
  .top-icon-btn:hover { background: rgba(255,255,255,0.15); }
  .top-icon-btn :global(svg) { width: 18px; height: 18px; }
  .player-center-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 88px; height: 88px; border-radius: 50%; background: rgba(232,181,71,0.9); color: #1A1408; display: flex; align-items: center; justify-content: center; z-index: 4; box-shadow: 0 8px 40px rgba(0,0,0,0.5); cursor: pointer; border: none; transition: all var(--t-fast); }
  .player-center-play:hover { transform: translate(-50%,-50%) scale(1.08); background: var(--gold); }
  .player-center-play :global(svg) { width: 36px; height: 36px; }
  .player-controls { position: absolute; bottom: 0; left: 0; right: 0; padding: 20px 24px 16px; background: linear-gradient(0deg, rgba(0,0,0,0.9) 0%, transparent 100%); z-index: 5; color: white; }
  .player-progress { position: relative; height: 4px; background: rgba(255,255,255,0.25); border-radius: 2px; cursor: pointer; margin-bottom: 14px; transition: height var(--t-fast); }
  .player-progress:hover { height: 6px; }
  .player-progress-bar { position: absolute; top: 0; right: 0; bottom: 0; width: 8%; background: var(--gold); border-radius: 2px; }
  .player-progress-buffered { position: absolute; top: 0; right: 0; bottom: 0; width: 20%; background: rgba(255,255,255,0.4); border-radius: 2px; }
  .player-progress-thumb { position: absolute; right: 8%; top: 50%; transform: translate(50%,-50%); width: 14px; height: 14px; background: var(--gold); border-radius: 50%; box-shadow: 0 2px 8px rgba(0,0,0,0.4); }
  .controls-row { display: flex; align-items: center; justify-content: space-between; gap: var(--sp-4); }
  .controls-left, .controls-right { display: flex; align-items: center; gap: 10px; }
  .ctrl-btn { width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center; color: white; border-radius: 8px; transition: all var(--t-fast); background: none; border: none; cursor: pointer; }
  .ctrl-btn:hover { background: rgba(255,255,255,0.15); }
  .ctrl-btn :global(svg) { width: 22px; height: 22px; }
  .ctrl-btn.play :global(svg) { width: 26px; height: 26px; }
  .ctrl-time { color: white; font-size: 13px; font-variant-numeric: tabular-nums; letter-spacing: 0.02em; padding: 0 4px; }
  .ctrl-time .sep { color: rgba(255,255,255,0.5); margin: 0 4px; }
  .volume-wrap { display: flex; align-items: center; gap: 4px; padding: 0 6px; }
  .volume-slider { width: 0; overflow: hidden; transition: width var(--t-med); }
  .volume-wrap:hover .volume-slider { width: 80px; }
  .volume-slider input { width: 80px; accent-color: var(--gold); }
  .quality-btn { padding: 4px 10px; background: var(--gold-dim); border: 1px solid var(--gold); border-radius: 6px; color: var(--gold); font-family: var(--font-heading); font-weight: 700; font-size: 11px; cursor: pointer; }
  .below-player { padding: var(--sp-6); max-width: 1000px; }
  .below-player h1 { font-size: 28px; font-weight: 900; margin-bottom: 4px; }
  .below-player .subtitle { color: var(--text-tertiary); font-size: 14px; margin-bottom: var(--sp-4); }
  .below-player .ep-title { font-size: 16px; font-weight: 700; color: var(--text-primary); margin-bottom: var(--sp-3); display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .below-player .ep-title .ep-num { color: var(--gold); font-size: 13px; font-weight: 700; padding: 3px 10px; background: var(--gold-dim); border-radius: 4px; }
  .below-player .ep-synopsis { color: var(--text-secondary); font-size: 15px; line-height: 1.75; margin-bottom: var(--sp-5); max-width: 720px; }
  .quick-actions { display: flex; gap: var(--sp-2); flex-wrap: wrap; margin-bottom: var(--sp-6); }
  .quick-btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; background: var(--bg-2); border: 1px solid var(--border); border-radius: 10px; color: var(--text-primary); font-size: 13px; font-weight: 600; transition: all var(--t-fast); text-decoration: none; cursor: pointer; }
  .quick-btn:hover { background: var(--bg-3); border-color: var(--gold); color: var(--gold); }
  .quick-btn :global(svg) { width: 16px; height: 16px; }
  .quick-btn.primary { background: var(--gold-dim); color: var(--gold); border-color: var(--gold); }
  .servers-section { padding-top: var(--sp-4); border-top: 1px solid var(--border); }
  .servers-title { font-size: 12px; text-transform: uppercase; color: var(--text-tertiary); letter-spacing: 0.08em; margin-bottom: var(--sp-3); font-family: var(--font-heading); font-weight: 700; }
  .servers-list { display: flex; gap: 8px; flex-wrap: wrap; }
  .server-btn { padding: 10px 16px; background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 8px; color: var(--text-secondary); font-size: 13px; font-weight: 500; transition: all var(--t-fast); display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
  .server-btn:hover { border-color: var(--border-strong); color: var(--text-primary); }
  .server-btn.active { background: var(--gold-dim); border-color: var(--gold); color: var(--gold); font-weight: 700; }
  .server-btn .status-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--success); }
  .episodes-sidebar { background: var(--bg-0); border-inline-start: 1px solid var(--border); padding: var(--sp-5); height: 100vh; position: sticky; top: 0; overflow-y: auto; }
  .sidebar-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--sp-4); }
  .sidebar-title h3 { font-size: 18px; font-weight: 800; margin-bottom: 2px; }
  .sidebar-title p { color: var(--text-tertiary); font-size: 12px; }
  .sidebar-season-select {
    padding: 6px 26px 6px 12px; background: rgba(255,255,255,0.06); border: 1px solid var(--border);
