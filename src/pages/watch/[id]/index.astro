---
// ============================================================================
// نقطة دخول المشاهدة /watch/:id — SSR — تحوّل المستخدم للحلقة/العرض الصحيح
// ----------------------------------------------------------------------------
// خفيفة جداً (احترام حد CPU 10ms): للأعمال المسلسلة تعيد التوجيه لأول حلقة
// في أول موسم متاح، وللأفلام تعيد التوجيه لمسار عرض الفيلم (season=0, ep=0).
// ============================================================================
export const prerender = false;

import { getDetailSSR, getEpisodes } from '../../../lib/data';

const { id } = Astro.params;
const origin = Astro.url;
const T = await getDetailSSR(id!, origin);

if (!T) {
  return new Response('العمل غير موجود', { status: 404 });
}

if (T.type === 'movie') {
  return Astro.redirect(`/watch/${id}/0/0`, 302);
}

// مسلسل/أنمي: نجد أول موسم وحلقة متاحة
const eps = await getEpisodes(id!, origin);
let seasonNum = 1;
let episodeNum = 1;
if (eps) {
  const keys = Object.keys(eps).map(Number).sort((a, b) => a - b);
  if (keys.length) {
    seasonNum = keys[0];
    const list = eps[String(seasonNum)];
    if (list && list.length) episodeNum = list[0].num;
  }
}

return Astro.redirect(`/watch/${id}/${seasonNum}/${episodeNum}`, 302);
---
