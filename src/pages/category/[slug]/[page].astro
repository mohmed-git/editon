---
// ============================================================================
// صفحة القسم المرقّمة — Static (prerender = true) — الصفحة N (N ≥ 2)
// ----------------------------------------------------------------------------
// كل صفحة ترقيم تُطبع HTML كامل بصورها وقت البناء. getStaticPaths يولّد صفحة
// لكل رقم (2..pages) لكل قسم. الصفحة 1 تُخدَّم من /category/[slug] لتفادي
// تكرار المسار (نتخطّى page=1 هنا).
// ============================================================================
export const prerender = true;

import Base from '../../../layouts/Base.astro';
import CategoryView from '../../../components/CategoryView.astro';
import { allCategorySlugs, catMetaStatic, catPageCards, catIndexRows } from '../../../lib/data-static';
import { SITE_NAME, SITE_URL } from '../../../lib/seo';

export function getStaticPaths() {
  const paths: { params: { slug: string; page: string } }[] = [];
  for (const slug of allCategorySlugs()) {
    const meta = catMetaStatic(slug);
    for (let p = 2; p <= meta.pages; p++) {
      paths.push({ params: { slug, page: String(p) } });
    }
  }
  return paths;
}

const { slug, page: pageParam } = Astro.params;
const page = parseInt(pageParam!, 10) || 1;

const META: Record<string, { title: string; subtitle: string; pageTitle: string; label: string }> = {
  movie:    { label: 'مكتبة الأفلام', title: 'أفلام مترجمة',    subtitle: 'أحدث الأفلام العالمية والعربية مترجمة أون لاين بجودة عالية.', pageTitle: `أفلام مترجمة اون لاين HD — ${SITE_NAME}` },
  series:   { label: 'مكتبة المسلسلات', title: 'مسلسلات مترجمة',  subtitle: 'أفضل المسلسلات الأجنبية والعربية بجميع المواسم والحلقات مترجمة.', pageTitle: `مسلسلات مترجمة — جميع المواسم والحلقات — ${SITE_NAME}` },
  anime:    { label: 'عالم الأنمي', title: 'أنمي مترجم',       subtitle: 'أحدث حلقات الأنمي مترجمة أون لاين كاملة.', pageTitle: `انمي مترجم اون لاين — الحلقات كاملة — ${SITE_NAME}` },
  trending: { label: 'الأكثر رواجاً', title: 'الأكثر رواجاً',   subtitle: 'الأعمال الأكثر مشاهدة وبحثاً هذا الأسبوع بحسب TMDB.', pageTitle: `الأكثر رواجاً الآن — ${SITE_NAME}` },
};

const meta = catMetaStatic(slug!);
const base = META[slug!] || { label: meta.label, title: meta.label, subtitle: '', pageTitle: `${meta.label} — ${SITE_NAME}` };
const navMap: Record<string, string> = { movie: 'movie', series: 'series', anime: 'anime', trending: 'trending' };

const cards = catPageCards(slug!, page);
const indexRows = catIndexRows(slug!);
const canonical = `/category/${slug}/${page}`;
const pageTitle = `${base.title} — صفحة ${page} — ${SITE_NAME}`;

const catSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${base.title} — صفحة ${page}`,
  description: base.subtitle,
  url: `${SITE_URL}/category/${slug}/${page}`,
  inLanguage: 'ar',
  isPartOf: { '@type': 'WebSite', name: SITE_NAME, url: SITE_URL },
};
---
<Base title={pageTitle} description={`${base.subtitle} على ${SITE_NAME}.`} canonical={canonical} schema={catSchema}>
  <CategoryView
    slug={slug!}
    page={page}
    meta={meta}
    cards={cards}
    indexRows={indexRows}
    label={base.label}
    title={base.title}
    subtitle={base.subtitle}
    navActive={navMap[slug!] || ''}
  />
</Base>
